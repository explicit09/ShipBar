{
  "name": "shipbar-relay-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Syncs a private ShipBar cloud relay with the signed local ShipBar bridge.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
